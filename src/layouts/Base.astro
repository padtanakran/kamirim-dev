---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'th';
}

const {
  title,
  description,
  image = '/og-image.png',
  lang = 'en',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Free Developer Resources`;
const pageDesc = description || (lang === 'th' ? site.description.th : site.description.en);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Language persistence script -->
    <script>
      (function () {
        const stored = localStorage.getItem('kamirim-lang');
        const html = document.documentElement;
        if (stored && stored !== html.lang) {
          // Lang mismatch — reload with correct lang if needed
          // Handled client-side via the Header switcher
        }
      })();
    </script>
  </body>
</html>
