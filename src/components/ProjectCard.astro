---
import { localized } from '../i18n/index';
import type { Lang } from '../i18n/index';
import { u } from '../utils/url';

export interface Props {
  slug: string;
  title: { en: string; th: string };
  description: { en: string; th: string };
  category: string;
  version: string;
  status: string;
  free?: boolean;
  featured?: boolean;
  image?: string;
  lang?: Lang;
  t: (key: string) => string;
}

const {
  slug,
  title,
  description,
  category,
  version,
  status,
  free = true,
  featured = false,
  image,
  lang = 'en',
  t,
} = Astro.props;
---

<a href={u(`/projects/${slug}`)} class:list={['project-card', { featured }]} aria-label={localized(title, lang)}>
  <div class="card-image-wrap">
    {image ? (
      <img src={image.startsWith('http') ? image : u(image)} alt={localized(title, lang)} class="card-image" loading="lazy" decoding="async" />
    ) : (
      <div class="card-image-placeholder" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path d="M3 9h18M9 21V9"/>
        </svg>
      </div>
    )}
    <div class="card-badges">
      {featured && <span class="badge badge-featured">{t('projects.featured')}</span>}
      {free && <span class="badge badge-free">{t('projects.free')}</span>}
    </div>
  </div>

  <div class="card-body">
    <div class="card-meta">
      <span class="card-category">{category}</span>
      <span class:list={['badge', `badge-${status}`]}>{t(`status.${status}`)}</span>
    </div>
    <h3 class="card-title">{localized(title, lang)}</h3>
    <p class="card-desc">{localized(description, lang)}</p>
    <div class="card-footer">
      <span class="card-version">{t('projects.version')}{version}</span>
      <span class="card-cta">{t('projects.viewProject')}</span>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-slow), background var(--transition-slow);
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-2);
  }

  .project-card.featured {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .card-image-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-2);
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--transition-slow);
  }

  .project-card:hover .card-image {
    opacity: 0.9;
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .card-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    gap: 6px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card-category {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .card-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .card-version {
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .card-cta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }

  .project-card:hover .card-cta {
    color: var(--text-primary);
  }
</style>
