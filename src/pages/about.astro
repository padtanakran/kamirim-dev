---
import Base from '../layouts/Base.astro';
import { t, getLang } from '../i18n/index';
import type { Lang } from '../i18n/index';
import site from '../data/site.json';

const langParam = Astro.url.searchParams.get('lang');
const lang: Lang = getLang(langParam);
const tl = (key: string) => t(lang, key);

const items = lang === 'th'
  ? ['ปลั๊กอิน Roblox Studio ฟรี', 'เครื่องมือสำหรับนักพัฒนา', 'แมพ โมเดล และเท็กซ์เจอร์', 'โปรเจกต์โอเพนซอร์ส']
  : ['Free Roblox Studio plugins', 'Developer tools and utilities', 'Maps, models, and textures', 'Open-source projects'];
---

<Base lang={lang} title={tl('about.title')}>
  <section class="section">
    <div class="container about-layout">
      <!-- Main -->
      <div class="about-main">
        <div class="about-label">{tl('about.title')}</div>
        <h1 class="about-heading">{tl('about.intro')}</h1>
        <p class="about-desc">{tl('about.description')}</p>

        <div class="about-section">
          <h2 class="about-section-title">{tl('about.whatIBuild')}</h2>
          <ul class="build-list">
            {items.map((item) => (
              <li class="build-item">
                <span class="build-dot"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="about-section">
          <h2 class="about-section-title">{tl('about.contact')}</h2>
          <p class="about-contact-text">{tl('about.contactText')}</p>
          <a href={`mailto:${site.email}`} class="btn btn-ghost about-contact-btn">
            {tl('about.contactButton')} →
          </a>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="about-sidebar">
        <div class="about-card">
          <div class="about-avatar" aria-hidden="true">K</div>
          <p class="about-name">Kamirim</p>
          <p class="about-handle">@kamirim</p>
        </div>

        <div class="about-links-card">
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="about-external-link"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>{tl('about.github')}</span>
            <span class="external-arrow">↗</span>
          </a>
          <a
            href={site.roblox}
            target="_blank"
            rel="noopener noreferrer"
            class="about-external-link"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
            </svg>
            <span>{tl('about.roblox')}</span>
            <span class="external-arrow">↗</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 64px;
    align-items: start;
  }

  .about-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .about-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .about-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 48px;
  }

  .about-section {
    margin-bottom: 48px;
  }

  .about-section-title {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .build-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .build-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .build-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
    margin-top: 8px;
  }

  .about-contact-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .about-contact-btn {
    font-size: 0.875rem;
  }

  /* Sidebar */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .about-card {
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .about-avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--bg-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0;
    margin-bottom: 4px;
  }

  .about-name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .about-handle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .about-links-card {
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .about-external-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    transition: color var(--transition), background var(--transition);
  }

  .about-external-link:last-child {
    border-bottom: none;
  }

  .about-external-link:hover {
    color: var(--text-primary);
    background: var(--bg-2);
  }

  .external-arrow {
    margin-left: auto;
    font-size: 0.75rem;
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about-sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .about-card, .about-links-card {
      flex: 1;
      min-width: 200px;
    }
  }
</style>
